{
  "name": "wow-survivors",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs *.json *.ts index.html",
    "format:check": "prettier --check src scripts tests docs *.json *.ts index.html",
    "balance": "tsx scripts/balance.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2"
  }
}
