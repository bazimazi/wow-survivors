{
  "name": "wow-survivors",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --open",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --open",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "format": "prettier --write src scripts tests docs *.json *.ts index.html",
    "format:check": "prettier --check src scripts tests docs *.json *.ts index.html",
    "balance": "tsx scripts/balance.ts",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2"
  }
}
