{
  "name": "wow-survivors",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-server.mjs --open",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/local-server.mjs --preview --open",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs *.json *.ts index.html",
    "format:check": "prettier --check src scripts tests docs *.json *.ts index.html",
    "balance": "tsx scripts/balance.ts",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2"
  }
}
